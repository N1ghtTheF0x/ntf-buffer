{
  "name": "@ntf/buffer",
  "version": "1.3.1",
  "description": "Another binary data manipulation library",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "pretest": "pnpm build",
    "test": "node tests/test.cjs",
    "check": "tsc --noEmit",
    "prebuild": "pnpm check",
    "build": "tsdown ./source/index.ts --dts --format esm,cjs --clean --sourcemap",
    "build:prod": "tsdown ./source/index.ts --dts --format esm,cjs --clean",
    "prepublishOnly": "npm run build:prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1ghtTheF0x/ntf-buffer.git"
  },
  "keywords": [
    "esm", "cjs", "nodejs", "browser", "arraybuffer", "buffer", "dataview", "typedarray", "typescript"
  ],
  "author": "N1ghtTheF0x",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/N1ghtTheF0x/ntf-buffer/issues"
  },
  "homepage": "https://github.com/N1ghtTheF0x/ntf-buffer#readme",
  "devDependencies": {
    "typescript": "latest",
    "tsdown": "latest"
  }
}
