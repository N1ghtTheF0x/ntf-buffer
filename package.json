{
  "name": "@ntf/buffer",
  "version": "1.3.0",
  "description": "Another binary data manipulation library",
  "files": ["dist"],
  "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
  "scripts": {
    "pretest": "pnpm build",
    "test": "tsx --tsconfig ./tests/nodejs/tsconfig.json ./tests/nodejs/test.cts",
    "check": "tsc --noEmit",
    "prebuild": "pnpm check",
    "build": "tsup ./source/index.ts --dts --format esm,cjs --clean --sourcemap",
    "build:prod": "tsup ./source/index.ts --dts --format esm,cjs --clean",
    "prepublishOnly": "npm run build:prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1ghtTheF0x/ntf-buffer.git"
  },
  "keywords": [
    "esm", "cjs", "nodejs", "browser", "arraybuffer", "buffer", "dataview", "typedarray", "typescript"
  ],
  "author": "N1ghtTheF0x",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/N1ghtTheF0x/ntf-buffer/issues"
  },
  "homepage": "https://github.com/N1ghtTheF0x/ntf-buffer#readme",
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "express": "latest",
    "tsup": "latest"
  }
}
